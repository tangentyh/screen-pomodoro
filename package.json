{
  "name": "screen-pomodoro",
  "version": "0.2.0",
  "description": "A tiny CLI pomodoro timer that pauses when your screen locks.",
  "type": "module",
  "license": "MIT",
  "author": "tangentyh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangentyh/screen-pomodoro.git"
  },
  "homepage": "https://github.com/tangentyh/screen-pomodoro#readme",
  "bugs": {
    "url": "https://github.com/tangentyh/screen-pomodoro/issues"
  },
  "keywords": [
    "cli",
    "pomodoro",
    "timer",
    "focus",
    "screen",
    "break",
    "reminder"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "screen-pomodoro": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "husky",
    "prepublishOnly": "npm run verify"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
